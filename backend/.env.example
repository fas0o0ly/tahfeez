# ─── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/tahfeez

# ─── JWT ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email (SendGrid) ─────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── App ──────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
APP_NAME=Tahfeez

# ─── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── Cloudinary ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Agora (Real-time video) ──────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# ─── OpenAI (Quran Guidance Chatbot) ──────────────────────────
OPENAI_API_KEY=
CHATBOT_CONFIDENCE_THRESHOLD=0.68

# ─── AI Memorization-Checker microservice ─────────────────────
# Internal only — must never be reachable from the public internet.
# Set to your GPU server's internal address, or leave unset to disable the feature.
AI_SERVICE_URL=http://127.0.0.1:8001
